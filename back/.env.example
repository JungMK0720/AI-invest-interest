# 로컬 개발용 예시 값입니다. 실제 배포에서는 Secret Manager 등에 별도 값을 넣으세요.
# 둘 다 비워 두면 관리자 계정을 만들지 않습니다. 비밀번호는 12자 이상이어야 합니다.
FINMATE_ADMIN_EMAIL=admin@finmate.local
FINMATE_ADMIN_PASSWORD=finmate-local-admin-2026

# 선택: 없으면 AI 설명은 규칙 기반 템플릿으로 대체됩니다.
ANTHROPIC_API_KEY=

# Supabase template only. Export these variables or register them with your host;
# Spring Boot does not automatically load .env. Requires migrations first.
# SPRING_PROFILES_ACTIVE=prod,supabase
# Copy the exact session pooler host/user from Dashboard > Connect (IPv4, port 5432).
# SPRING_DATASOURCE_URL=jdbc:postgresql://REPLACE-WITH-POOLER-HOST:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=finmate_app.REPLACE-WITH-PROJECT-REF
# SPRING_DATASOURCE_PASSWORD=REPLACE-IN-SECRET-MANAGER
# FINMATE_DB_SCHEMA=finmate
# FINMATE_DB_POOL_SIZE=5
# FINMATE_DB_SSL_MODE=require
# For production, use verify-full and add sslrootcert=/absolute/ca.crt to the JDBC URL.
# FRONTEND_ORIGIN=https://REPLACE-WITH-FRONTEND-DOMAIN
